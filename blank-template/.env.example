# Quick Start fills the {{...}} placeholders in when it copies this template
# into your workspace. Copying by hand? Replace them with your own values.

# --- Cloudgate IdP auth ---------------------------------------------------
# Base URL of the IdP (used to build the hosted login page URL).
# Login redirects to: {VITE_IDP_BASE_URL}/idp/{tenancy}/login
VITE_IDP_BASE_URL={{hubUrl}}

# Separate API base for IdP profile/refresh calls.
# Falls back to VITE_IDP_BASE_URL when empty.
VITE_IDP_API_URL={{apiUrl}}

# Tenant selected by Cloudgate setup. Query parameters cannot override it.
VITE_IDP_TENANCY_NAME={{tenancyName}}

# Where the IdP should redirect back after login (appended as ?returnUrl=).
# Left blank on new apps: your app's URL isn't known until you run or publish
# it. IMPORTANT: set this to your app's URL (dev preview while testing, your
# published domain in production) to ensure your users are always returned to
# the app after login. When blank, login falls back to the page the user
# logged in from.
VITE_IDP_RETURN_URL=

# --- Native back-office application scope --------------------------------
# Local environment: "sbx" or "prod". Published apps use their site metadata.
VITE_CLOUDGATE_API_ENV={{environment}}

# Published apps discover their web app ID from Cloudgate's cg-analytics.json.
# For local development, set the ID of a web app owned by your tenant.
# Copy it from Cloudgate > Web Apps > Apps > Edit (pencil) > General > Web app ID.
VITE_CLOUDGATE_WEB_APP_ID=

# Optional prefix for an existing media library, e.g. admin. New apps use apps/<webAppId>.
VITE_CLOUDGATE_MEDIA_FOLDER=

# --- Optional workflow extensions ----------------------------------------
# Leave blank unless you add workflows. No controller is needed by the back office.
VITE_CLOUDGATE_API_PROJECT=
# Optional gateway address for your app-specific integrations.
# Gateway host only; request paths append /{API_ENV}/{API_PROJECT}/{route}.
VITE_CLOUDGATE_API_URL={{workflowGatewayUrl}}

# No API key or secret belongs in this browser app. Native features use IdP bearer auth.
