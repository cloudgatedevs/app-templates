{
  "templates": [
    {
      "id": "react-template",
      "name": "React Template",
      "description": "Blank React app foundation powered by the Cloudgate npm SDK. Shared authentication, profile/account linking, users, notifications, analytics, appearance, SMTP, media and payments are managed by the package. Generic placeholder pages guide you to the Developers tools to start building.",
      "folder": "react-template",
      "framework": "React",
      "devCommand": "npm install && npm run dev",
      "devPort": 3000,
      "thumbnail": "https://raw.githubusercontent.com/cloudgatedevs/app-templates/main/react-template/banner.svg",
      "demoUrl": "https://admin.app.cloudgate.dev/",
      "tags": [
        "react",
        "vite",
        "tailwind",
        "admin",
        "back-office",
        "analytics",
        "idp",
        "notifications",
        "wallet",
        "theming",
        "responsive",
        "skeleton"
      ],
      "appSettings": {
        "app_tagline": "Back office",
        "theme_mode": "light",
        "theme_density": "content",
        "theme_primary": "#4f46e5",
        "theme_secondary": "#7c3aed",
        "theme_neutral": "#64748b",
        "theme_success": "#15803d",
        "theme_warning": "#a16207",
        "theme_danger": "#be123c",
        "theme_info": "#0369a1",
        "enable_public_website": "false",
        "require_public_website_login": "false"
      }
    }
  ]
}
