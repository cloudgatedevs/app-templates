# Quick Start fills the {{...}} placeholders in when it copies this template
# into your workspace. Copying by hand? Replace them with your own values.

# --- Cloudgate IdP auth ---------------------------------------------------
# Base URL of the IdP (used to build the hosted login page URL).
# Login redirects to: {VITE_IDP_BASE_URL}/idp/{tenancy}/login
VITE_IDP_BASE_URL={{hubUrl}}

# Separate API base for IdP profile/refresh calls.
# Falls back to VITE_IDP_BASE_URL when empty.
VITE_IDP_API_URL={{apiUrl}}

# Tenancy name. Can be overridden at runtime via ?idp_tenant= query param
# or a subdomain (e.g. acme.example.com -> "acme").
VITE_IDP_TENANCY_NAME={{tenancyName}}

# Where the IdP should redirect back after login (appended as ?returnUrl=).
# Left blank on new apps: your app's URL isn't known until you run or publish
# it. IMPORTANT: set this to your app's URL (dev preview while testing, your
# published domain in production) to ensure your users are always returned to
# the app after login. When blank, login falls back to the page the user
# logged in from.
VITE_IDP_RETURN_URL=

# --- Cloudgate workflow API ----------------------------------------------
# Gateway host that serves workflow endpoints. Host only — the environment
# and project segments below are appended to it, so do NOT include them here.
VITE_CLOUDGATE_API_URL={{workflowGatewayUrl}}

# Publish slot the app calls: "sbx" (sandbox) or "prod" (production). This is
# the single value to flip to move the whole app between environments.
VITE_CLOUDGATE_API_ENV=sbx

# Project path segment holding your published endpoints. Together the three
# keys build the request base: {API_URL}/{API_ENV}/{API_PROJECT}/{route}
VITE_CLOUDGATE_API_PROJECT=api

# Gateway request-signing credentials (HMAC) for the sandbox API key that
# Quick Start creates for this project.
VITE_API_KEY={{apiKey}}
VITE_API_SECRET={{apiSecret}}
